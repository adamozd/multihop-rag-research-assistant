WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://ca-tor.ml.cloud.ibm.com
# Verify this ID in your region before use; no silent model fallback.
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct
# Baseline output limit; efficient mode also caps each response at 1800 tokens.
WATSONX_MAX_NEW_TOKENS=3000
# Counts and statuses only; no prompt or response text.
LLM_USAGE_LOG=data/usage.jsonl
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=research_bge_small_v1
# Local catalog and uploaded PDFs; separate from the starter corpus.
LIBRARY_PATH=data/library
API_URL=http://127.0.0.1:8000
