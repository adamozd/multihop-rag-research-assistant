{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Research Assistant: API",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "module": "uvicorn",
      "args": ["api.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Research Assistant: Frontend",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "module": "streamlit",
      "args": ["run", "frontend/app.py", "--server.address", "127.0.0.1", "--server.port", "8501"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Research Assistant: Validate watsonx",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": { "python": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "module": "llm.watsonx_client",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Research Assistant: Full app",
      "configurations": ["Research Assistant: API", "Research Assistant: Frontend"],
      "stopAll": true
    }
  ]
}
